pipeline {
    agent any // Runs on your Windows agent

    environment {
        PYTHONUNBUFFERED = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing requirements...'
                // sh 'python -m pip install --upgrade pip'
                sh 'pip3 install -r requirements.txt'

                echo 'Verifying installed packages...'
                // This will print the list of installed Python modules to the console log
                sh 'pip3 list'
            }
        }

        stage('Execute Tests') {
            steps {
                echo 'Running native Python Pytest suite...'
                sh 'pytest test_solution.py --junitxml=test-reports/results.xml'
            }
        }
    }

    post {
        always {
            echo 'Publishing test results to Jenkins UI...'
            junit 'test-reports/results.xml'
        }
    }
}