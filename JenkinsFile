pipeline {
    agent any // Runs on your Windows agent

    environment {
        PYTHONUNBUFFERED = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing requirements...'
                sh 'python -m pip install --upgrade pip'
                sh 'python -m pip install -r requirements.txt'
            }
        }

        stage('Execute Tests') {
            steps {
                echo 'Running native Python Pytest suite...'
                sh 'pytest test_solution.py --junitxml=test-reports/results.xml'
            }
        }
    }

    post {
        always {
            echo 'Publishing test results to Jenkins UI...'
            junit 'test-reports/results.xml'
        }
    }
}