pipeline {
    agent any

    environment {
        PYTHONUNBUFFERED = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Creating Python Virtual Environment...'
                // 1. Create a fresh virtual environment named 'venv'
                sh 'python3 -m venv venv'
                
                echo 'Installing requirements inside venv...'
                // 2. Use the local pip inside the venv to install requirements safely
                sh './venv/bin/pip install -r requirements.txt'
                
                echo 'Verifying installed packages...'
                // 3. Check the packages inside the venv
                sh './venv/bin/pip list'
            }
        }

        stage('Execute Tests') {
            steps {
                echo 'Running Pytest from virtual environment...'
                // 4. Run pytest directly from the venv's bin directory
                sh './venv/bin/pytest tests/test_Solution.py --junitxml=test-reports/results.xml'
            }
        }
    }

    post {
        always {
            echo 'Publishing test results to Jenkins UI...'
            junit 'test-reports/results.xml'
        }
    }
}